# ==============================================================================
# Local Advanced RAG System - Environment Configuration Template
# Copy this file to `.env` and customize as needed for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking Configuration
# ------------------------------------------------------------------------------
# Bind host: Use 127.0.0.1 for local-only, or 0.0.0.0 to expose on local network/VM/Docker
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
RELOAD=true

# Streamlit Frontend connection URL to FastAPI backend
# Change this if the backend is hosted on a remote Ubuntu VM, container, or server
API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Local Ollama LLM & Embedding Settings
# ------------------------------------------------------------------------------
# Ollama service endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Generation model (e.g., llama3.2, llama3.2:3b, qwen2.5:7b, gemma3:1b)
LLM_MODEL=llama3.2

# Embedding model (e.g., nomic-embed-text, bge-m3, all-MiniLM-L6-v2)
EMBEDDING_MODEL=nomic-embed-text

# Generation sampling temperature (0.0 = deterministic/factual, 0.7 = creative)
TEMPERATURE=0.1

# Maximum tokens generated in LLM response
MAX_TOKENS=1536

# Context window size in tokens (recommended: 4096 - 8192)
NUM_CTX=6144

# Ollama request timeout in seconds (increase to 300+ on CPU to prevent read timeouts)
TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 3. Hardware & Acceleration Settings (Manual Activation Only)
# Note: Acceleration is NOT automatically activated by default.
# ------------------------------------------------------------------------------
# Set to 'true' to manually activate hardware acceleration for local inference
ENABLE_ACCELERATION=false

# Target compute device:
#   - 'cpu'  : Multi-threaded CPU acceleration (recommended for CPU-only systems)
#   - 'gpu'  : GPU hardware acceleration (requires CUDA / NVIDIA drivers)
#   - 'auto' : Automatically uses CUDA GPU if detected, otherwise falls back to CPU
ACCELERATION_DEVICE=cpu

# Number of worker threads to allocate when acceleration is active (1-32)
# Tip: On Linux/Ubuntu, check your core count with `nproc` (e.g., 4, 6, 8, 12)
ACCELERATION_THREADS=4

# Baseline single-thread fallback when acceleration is inactive
NUM_THREADS=1

# ------------------------------------------------------------------------------
# 4. Storage & Persistence Paths
# ------------------------------------------------------------------------------
VECTOR_DB_PATH=./data/chroma_db
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
EVALUATION_DIR=./data/evaluations
SQLITE_DB_PATH=./data/rag_app.db
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 5. Chunking & Contextual Retrieval Strategy
# ------------------------------------------------------------------------------
# Chunking strategy: structure_aware, recursive_character, sentence, paragraph, fixed_size
CHUNK_STRATEGY=structure_aware
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PARENT_CHUNK_SIZE=2500
ENABLE_PARENT_CHILD=true

# Contextual Retrieval (Anthropic-style situated chunk preambles)
ENABLE_CONTEXTUAL_RETRIEVAL=true

# Contextual mode:
#   - 'structural' : Instant, zero-latency document & section anchor preambles (Recommended)
#   - 'llm'        : Dynamic local LLM synthesis of chunk context
CONTEXTUAL_MODE=structural

# ------------------------------------------------------------------------------
# 6. Retrieval & Ranking Configuration
# ------------------------------------------------------------------------------
# Retrieval strategy: hybrid (Dense + BM25 via RRF), semantic (Dense only), keyword (BM25 only)
RETRIEVAL_STRATEGY=hybrid
TOP_K=15
SIMILARITY_THRESHOLD=0.3
RRF_K=60

# Neural Cross-Encoder Reranking
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5
CONTEXT_COMPRESSION=true

# ------------------------------------------------------------------------------
# 7. Multimodal Vision (Diagrams, Flowcharts, & Visual Charts)
# ------------------------------------------------------------------------------
# Set to 'false' to skip image transcription and maximize document ingestion speed
# Requires local vision model: 'ollama pull moondream' or 'ollama pull llava'
ENABLE_VISION=false
VISION_MODEL=moondream
VISION_MIN_IMAGE_SIZE=4096
VISION_MIN_DIMENSION=100
VISION_MAX_IMAGES_PER_PAGE=3

# ------------------------------------------------------------------------------
# 8. Security & Processing
# ------------------------------------------------------------------------------
MAX_QUERY_LENGTH=1000
ENABLE_OCR=false
LOG_LEVEL=INFO
